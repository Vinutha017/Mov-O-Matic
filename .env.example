# Core AI configuration
# Required for itinerary generation and AI travel recommendations.
GEMINI_API_KEY=your_gemini_api_key_here

# Database configuration
# Use your PostgreSQL connection string here.
DATABASE_URL=your_postgresql_connection_string_here

# Session configuration
# Use a long random secret for auth/session cookies.
SESSION_SECRET=your_long_random_session_secret_here

# Firebase configuration
# Copy these values from Firebase Console > Project settings > Your apps > Firebase SDK snippet.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Server configuration
PORT=5000
NODE_ENV=production

# Client-to-server API base URL.
# Set this in Vercel to your Railway backend URL.
VITE_API_URL=https://your-railway-backend.up.railway.app

# Allowed browser origin for the backend.
# Set this in Railway to your Vercel frontend domain.
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional integrations
WEATHER_API_KEY=your_weather_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Public app URL
# Used for share links and WhatsApp sharing in production.
VITE_APP_PUBLIC_URL=https://your-frontend.vercel.app