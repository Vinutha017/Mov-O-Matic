# Core AI configuration
# Required for itinerary generation and AI travel recommendations.
GEMINI_API_KEY=your_gemini_api_key

# Database configuration
# Use your PostgreSQL connection string here.
DATABASE_URL=postgresql://your_user:your_password@your-hostname/your_database?sslmode=require

# Session configuration
# Use a long random secret for auth/session cookies.
SESSION_SECRET=replace_with_a_long_random_secret

# Firebase configuration
# Copy these values from Firebase Console > Project settings > Your apps > Firebase SDK snippet.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Server configuration
PORT=5000
NODE_ENV=production

# Client-to-server API base URL.
# Set this in Vercel to your Railway backend URL.
VITE_API_URL=https://your-backend.example.com

# Allowed browser origin for the backend.
# Set this in Railway to your Vercel frontend domain.
CORS_ORIGIN=https://your-frontend.example.com

# Optional integrations
WEATHER_API_KEY=your_weather_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Public app URL
# Used for share links and WhatsApp sharing in production.
VITE_APP_PUBLIC_URL=https://your-frontend.example.com
